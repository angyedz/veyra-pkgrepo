#!/usr/bin/python3
"""Run persistent development environments over the running Veyra root."""

from __future__ import annotations

import argparse
import errno
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import tomllib
import uuid
from pathlib import Path, PurePosixPath
from typing import Sequence


NAME_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,54}$")
PROJECT_CONFIG = ".vforge.toml"
PERMISSION_FILE = "approved-mounts.json"
FEDORA_RELEASE = "44"
VEYRA_IMAGE_ID = "veyra-next"


class VforgeError(Exception):
    pass


def config_directory() -> Path:
    configured = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")).expanduser()
    if not configured.is_absolute():
        raise VforgeError("XDG_CONFIG_HOME must be an absolute path")
    directory = configured / "vforge"
    ensure_private_directory(directory)
    return directory


def ensure_private_directory(path: Path) -> None:
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        info = path.lstat()
    except OSError as error:
        raise VforgeError(f"cannot inspect private Vforge directory {path}: {error}") from error
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        raise VforgeError(f"Vforge directory must be a real directory owned by the current user: {path}")
    if info.st_mode & 0o077:
        os.chmod(path, 0o700)


def verify_private_directory(path: Path, description: str) -> None:
    try:
        info = path.lstat()
    except OSError as error:
        raise VforgeError(f"cannot inspect {description} {path}: {error}") from error
    if (stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode)
            or info.st_uid != os.getuid() or info.st_mode & 0o077):
        raise VforgeError(f"{description} must be a private directory owned by the current user: {path}")


def read_private_json(path: Path, description: str) -> object:
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise VforgeError(f"cannot safely open {description} {path}: {error}") from error
    try:
        info = os.fstat(descriptor)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_mode & 0o077):
            raise VforgeError(f"{description} must be a private regular file owned by the current user: {path}")
        with os.fdopen(descriptor, "r", encoding="utf-8") as stream:
            descriptor = -1
            return json.load(stream)
    except (OSError, json.JSONDecodeError) as error:
        raise VforgeError(f"cannot read {description} {path}: {error}") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def read_private_json_optional(path: Path, description: str, default: object) -> object:
    try:
        return read_private_json(path, description)
    except VforgeError as error:
        if isinstance(error.__cause__, FileNotFoundError):
            return default
        raise


def write_private_json(path: Path, value: object, description: str) -> None:
    ensure_private_directory(path.parent)
    try:
        info = path.lstat()
    except FileNotFoundError:
        info = None
    except OSError as error:
        raise VforgeError(f"cannot inspect {description} {path}: {error}") from error
    if info is not None and (stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode)
                             or info.st_uid != os.getuid()):
        raise VforgeError(f"{description} must be a regular file owned by the current user: {path}")

    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            os.fchmod(stream.fileno(), 0o600)
            json.dump(value, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def store_root() -> Path:
    configured = os.environ.get("VFORGE_STORAGE_ROOT")
    if configured:
        root = Path(configured).expanduser()
    else:
        config = read_private_json_optional(config_directory() / "config.json", "Vforge configuration", {})
        configured = config.get("storage_root") if isinstance(config, dict) else None
        data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")).expanduser()
        if not data_home.is_absolute():
            raise VforgeError("XDG_DATA_HOME must be an absolute path")
        root = Path(configured).expanduser() if isinstance(configured, str) and configured else data_home / "vforge"
    if not root.is_absolute():
        raise VforgeError("Vforge storage root must be an absolute path")
    return root.resolve()


def validate_name(name: str) -> str:
    if not NAME_RE.fullmatch(name):
        raise VforgeError("environment name must use lowercase letters, digits, dots, dashes, or underscores")
    return name


def environment_path(name: str, *, project: Path | None = None) -> Path:
    validate_name(name)
    return (project / ".vforge" if project else store_root() / "environments") / name


def environment_metadata(path: Path) -> dict:
    path = path.absolute()
    verify_private_directory(path, "Vforge environment")
    metadata_path = path / "environment.json"
    try:
        value = read_private_json(metadata_path, "Vforge environment metadata")
    except VforgeError as error:
        raise VforgeError(f"cannot read environment metadata at {metadata_path}: {error}") from error
    if not isinstance(value, dict) or value.get("schema") not in {1, 2} or value.get("backend") != "overlayfs":
        raise VforgeError("environment metadata is invalid or was created by an unsupported Vforge backend")
    name = validate_name(value.get("name", ""))
    if name != path.name or value.get("lower") != "/":
        raise VforgeError("environment metadata does not match its Veyra root or directory name")
    if value.get("upper") != str(path / "upper") or value.get("work") != str(path / "work"):
        raise VforgeError("environment upper and work directories must stay inside its private state directory")
    verify_private_directory(path / "upper", "OverlayFS upper directory")
    verify_private_directory(path / "work", "OverlayFS work directory")
    validate_mount_records(value.get("mounts", []))
    project = value.get("project")
    if project is None:
        expected = store_root() / "environments" / name
        if path != expected:
            raise VforgeError("named environment state is outside the configured Vforge storage root")
        verify_private_directory(path.parent, "named environment storage")
    else:
        if not isinstance(project, str) or not Path(project).is_absolute():
            raise VforgeError("project environment metadata has an invalid project path")
        project_path = Path(project)
        if not project_path.is_dir() or project_path.resolve() != project_path:
            raise VforgeError("project environment path must be an existing canonical directory")
        if path != project_path / ".vforge" / name or path.parent.is_symlink():
            raise VforgeError("project environment state is outside its project .vforge directory")
        verify_private_directory(path.parent, "project Vforge state directory")
    root_id = value.get("root_id")
    if root_id is not None and (not isinstance(root_id, str) or not re.fullmatch(r"[0-9a-f]{32}", root_id)):
        raise VforgeError("environment metadata has an invalid root identity")
    if value.get("schema") == 1 or root_id is None:
        value["schema"] = 2
        value["root_id"] = uuid.uuid4().hex
        write_metadata(path, value)
    return value


def write_metadata(path: Path, metadata: dict) -> None:
    write_private_json(path / "environment.json", metadata, "Vforge environment metadata")


def run(command: Sequence[str], *, check: bool = True) -> subprocess.CompletedProcess:
    try:
        result = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except FileNotFoundError as error:
        raise VforgeError(f"required system tool is missing: {command[0]}") from error
    if check and result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit status {result.returncode}"
        raise VforgeError(detail)
    return result


def checked_mount_target(target: str) -> str:
    path = PurePosixPath(target)
    if (not path.is_absolute() or len(path.parts) < 2 or str(path) != target
            or any(part in {".", ".."} for part in path.parts)):
        raise VforgeError(f"mount target must be a safe absolute path below /: {target}")
    if path.parts[1] in {"proc", "sys", "dev", "run", "etc", "usr", "boot", "var", "home"}:
        raise VforgeError(f"mount target is reserved by Vforge: {target}")
    return str(path)


def validate_mount_records(items: object) -> list[dict[str, str]]:
    if not isinstance(items, list):
        raise VforgeError("environment mounts must be an array")
    result = []
    for item in items:
        if (not isinstance(item, dict) or set(item) != {"source", "target", "access"}
                or not isinstance(item["source"], str) or not isinstance(item["target"], str)
                or not isinstance(item["access"], str)):
            raise VforgeError("environment mount metadata is malformed")
        source = Path(item["source"])
        if not source.is_absolute() or ".." in source.parts:
            raise VforgeError("environment mount source must be an absolute canonical path")
        target = checked_mount_target(item["target"])
        access = item["access"]
        if access not in {"read-only", "read-write"}:
            raise VforgeError(f"invalid mount access for {target}: {access}")
        result.append({"source": str(source), "target": target, "access": access})
    return result


def normalize_mounts(items: object) -> list[dict[str, str]]:
    if not isinstance(items, list):
        raise VforgeError("permissions.mounts must be an array of tables")
    result = []
    for item in items:
        if (not isinstance(item, dict) or {"source", "target"} - set(item)
                or set(item) - {"source", "target", "access"}
                or not isinstance(item.get("source"), str) or not isinstance(item.get("target"), str)):
            raise VforgeError("each mount must contain only source, target, and access")
        source = Path(item["source"]).expanduser()
        if not source.is_absolute() or ".." in source.parts:
            raise VforgeError("mount source must be an absolute path without parent traversal")
        target = checked_mount_target(item["target"])
        access = item.get("access", "read-only")
        if not isinstance(access, str) or access not in {"read-only", "read-write"}:
            raise VforgeError(f"invalid mount access for {target}: {access}")
        current = Path(source.anchor)
        for component in source.parts[1:]:
            current = current / component
            if current.is_symlink():
                raise VforgeError(f"mount source path must not traverse symlinks: {source}")
        try:
            resolved = source.resolve(strict=True)
        except (OSError, RuntimeError) as error:
            raise VforgeError(f"mount source does not exist: {source}") from error
        if not resolved.is_dir():
            raise VforgeError(f"mount source must be a directory: {resolved}")
        result.append({"source": str(resolved), "target": target, "access": access})
    return result


def project_mount_approvals(project: Path) -> list[dict[str, str]]:
    approval_path = config_directory() / PERMISSION_FILE
    state = read_private_json_optional(
        approval_path, "Vforge mount approvals", {"schema": 1, "projects": {}}
    )
    if not isinstance(state, dict) or state.get("schema") != 1 or not isinstance(state.get("projects"), dict):
        raise VforgeError("Vforge mount approval state is malformed")
    for project_name, mounts in state["projects"].items():
        if not isinstance(project_name, str) or not Path(project_name).is_absolute():
            raise VforgeError("Vforge mount approval state contains an invalid project path")
        state["projects"][project_name] = validate_mount_records(mounts)
    return state["projects"].get(str(project), [])


def authorize_project_mounts(name: str, project: Path, requested: list[dict[str, str]]) -> None:
    approval_path = config_directory() / PERMISSION_FILE
    state = read_private_json_optional(
        approval_path, "Vforge mount approvals", {"schema": 1, "projects": {}}
    )
    if not isinstance(state, dict) or state.get("schema") != 1 or not isinstance(state.get("projects"), dict):
        raise VforgeError("Vforge mount approval state is malformed")
    approved = project_mount_approvals(project)
    added = [item for item in requested if item not in approved]
    if added:
        confirm_permissions(name, added)
    if requested:
        state["projects"][str(project)] = requested
    else:
        state["projects"].pop(str(project), None)
    write_private_json(approval_path, state, "Vforge mount approvals")


def confirm_permissions(name: str, requested: list[dict[str, str]]) -> None:
    print(f"Environment '{name}' requests additional host mounts:")
    print(json.dumps(requested, indent=2, sort_keys=True))
    if not sys.stdin.isatty():
        raise VforgeError("additional host mounts require interactive approval")
    if input("Allow these mounts? [y/N] ").strip().lower() not in {"y", "yes"}:
        raise VforgeError("host mount permission was not granted")


def create(name: str, *, project: Path | None = None, mounts: list[dict[str, str]] | None = None) -> Path:
    validate_name(name)
    if project is not None:
        project = project.resolve(strict=True)
        if not project.is_dir():
            raise VforgeError("project path must be a directory")
        ensure_private_directory(project / ".vforge")
        requested = validate_mount_records(mounts or [])
        authorize_project_mounts(name, project, requested)
    else:
        requested = validate_mount_records(mounts or [])
        if requested:
            raise VforgeError("host mounts can only be configured in a project .vforge.toml file")
        ensure_private_directory(store_root())
        ensure_private_directory(store_root() / "environments")
    path = environment_path(name, project=project)
    if path.is_symlink():
        raise VforgeError("project Vforge state may not use symlinks")
    if path.exists():
        current = environment_metadata(path)
        if current.get("project") != (str(project) if project else None):
            raise VforgeError(f"environment '{name}' already belongs to a different project")
        previous = current.get("mounts", [])
        if requested != previous:
            current["mounts"] = requested
            write_metadata(path, current)
        print(f"Environment '{name}' already exists at {path}")
        return path
    ensure_private_directory(path.parent)
    path.mkdir(mode=0o700)
    (path / "upper").mkdir(mode=0o700)
    (path / "work").mkdir(mode=0o700)
    metadata = {
        "schema": 2,
        "backend": "overlayfs",
        "name": name,
        "root_id": uuid.uuid4().hex,
        "lower": "/",
        "upper": str(path / "upper"),
        "work": str(path / "work"),
        "project": str(project) if project else None,
        "mounts": requested,
    }
    write_metadata(path, metadata)
    print(f"Created native OverlayFS environment '{name}' at {path}")
    return path


def project_settings(project: Path) -> tuple[str, list[dict[str, str]]]:
    config = project / PROJECT_CONFIG
    try:
        descriptor = os.open(config, os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0))
    except FileNotFoundError:
        return project.name.lower().replace(" ", "-")[:55] or "project", []
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise VforgeError("project Vforge configuration may not be a symlink") from error
        raise VforgeError(f"cannot safely open project Vforge configuration: {error}") from error
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise VforgeError("project Vforge configuration must be a regular file")
        with os.fdopen(descriptor, "r", encoding="utf-8") as stream:
            descriptor = -1
            value = tomllib.loads(stream.read())
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise VforgeError(f"invalid project configuration: {error}") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    environment = value.get("environment", {})
    permissions = value.get("permissions", {})
    if not isinstance(environment, dict) or not isinstance(permissions, dict):
        raise VforgeError("[environment] and [permissions] must be tables")
    name = validate_name(str(environment.get("name", project.name.lower().replace(" ", "-")[:55])))
    if environment.get("isolation", "integrated") != "integrated":
        raise VforgeError("native Vforge currently supports only the integrated isolation profile")
    home_mode = permissions.get("home", {}).get("mode", "project-only") if isinstance(permissions.get("home", {}), dict) else None
    if home_mode != "project-only":
        raise VforgeError("native Vforge currently supports project-only Home access")
    mounts = normalize_mounts(permissions.get("mounts", []))
    return name, mounts


def project_up(cwd: Path) -> Path:
    project = cwd.resolve()
    name, mounts = project_settings(project)
    return create(name, project=project, mounts=mounts)


def namespace_command(path: Path, command: Sequence[str]) -> int:
    metadata = environment_metadata(path)
    verify_project_mount_approvals(metadata)
    if not command:
        command = ["/bin/bash", "--login"]
    arguments = [
        "unshare", "--user", "--map-root-user", "--mount", "--pid", "--fork", "--net",
        sys.executable, str(Path(__file__).resolve()), "_run", str(path), *command,
    ]
    try:
        result = subprocess.run(arguments)
    except FileNotFoundError as error:
        raise VforgeError("the unshare utility is required for native Vforge environments") from error
    if result.returncode:
        return result.returncode
    return 0


def verify_project_mount_approvals(metadata: dict) -> None:
    project = metadata.get("project")
    if project is None:
        return
    approved = project_mount_approvals(Path(project))
    if any(mount not in approved for mount in metadata.get("mounts", [])):
        raise VforgeError("project environment contains unapproved host mounts; review .vforge.toml with `vforge up`")


def mount_in_namespace(
    source: str,
    target: str,
    *,
    readonly: bool = False,
    mountpoints: list[str] | None = None,
) -> None:
    source_path = Path(source)
    if not source_path.is_absolute() or ".." in source_path.parts:
        raise VforgeError(f"mount source must be an absolute path without parent traversal: {source}")
    path_flags = getattr(os, "O_PATH", os.O_RDONLY) | getattr(os, "O_CLOEXEC", 0)
    directory_flags = path_flags | os.O_DIRECTORY
    descriptor = os.open(source_path.anchor, directory_flags)
    try:
        components = source_path.parts[1:]
        for index, component in enumerate(components):
            final_component = index == len(components) - 1
            component_flags = path_flags | getattr(os, "O_NOFOLLOW", 0)
            if not final_component:
                component_flags |= os.O_DIRECTORY
            next_descriptor = os.open(component, component_flags, dir_fd=descriptor)
            os.close(descriptor)
            descriptor = next_descriptor
            if stat.S_ISLNK(os.fstat(descriptor).st_mode):
                raise VforgeError(f"mount source may not traverse a symlink: {source}")
        pinned_source = f"/proc/self/fd/{descriptor}"
        run(["mount", "--bind", pinned_source, target])
        if mountpoints is not None:
            mountpoints.append(target)
        if readonly:
            run(["mount", "-o", "remount,bind,ro", target])
    except OSError as error:
        raise VforgeError(f"cannot safely open mount source {source}: {error}") from error
    finally:
        os.close(descriptor)


def unmount_all(mountpoints: Sequence[str]) -> list[str]:
    failed = []
    for target in reversed(mountpoints):
        result = run(["umount", "--", target], check=False)
        if result.returncode:
            result = run(["umount", "--lazy", "--", target], check=False)
        if result.returncode:
            failed.append(target)
    return failed


def veyra_root_marker(
    metadata: dict,
    root: Path,
    cmdline_path: Path = Path("/proc/cmdline"),
) -> dict[str, object]:
    release_path = root / "usr/lib/os-release"
    try:
        release_text = release_path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        raise VforgeError("the Veyra root does not contain a readable /usr/lib/os-release") from error
    wanted = {"ID", "VERSION_ID", "IMAGE_ID", "IMAGE_VERSION"}
    fields: dict[str, str] = {}
    for line in release_text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, raw = line.split("=", 1)
        if key not in wanted:
            continue
        if key in fields:
            raise VforgeError(f"Veyra os-release contains duplicate {key} fields")
        try:
            values = shlex.split(raw, comments=True, posix=True)
        except ValueError as error:
            raise VforgeError(f"Veyra os-release has malformed {key} syntax") from error
        if len(values) != 1 or not values[0]:
            raise VforgeError(f"Veyra os-release has an invalid {key} value")
        fields[key] = values[0]
    if set(fields) != wanted or fields["ID"] != "fedora" or fields["VERSION_ID"] != FEDORA_RELEASE:
        raise VforgeError("Vforge requires the Fedora 44 Veyra system root")
    if fields["IMAGE_ID"] != VEYRA_IMAGE_ID or not re.fullmatch(r"[A-Za-z0-9._+-]+", fields["IMAGE_VERSION"]):
        raise VforgeError("Vforge requires a supported Veyra deployment identity")

    try:
        command_line = cmdline_path.read_text(encoding="ascii")
    except (OSError, UnicodeError) as error:
        raise VforgeError("cannot read the running Veyra kernel command line") from error
    hashes = re.findall(r"(?:^|\s)roothash=([0-9a-f]{64})(?:\s|$)", command_line)
    if len(hashes) != 1:
        raise VforgeError("Vforge requires one dm-verity roothash from the running Veyra deployment")
    return {
        "schema": 1,
        "kind": "vforge-veyra-root",
        "root_id": metadata["root_id"],
        "image_id": fields["IMAGE_ID"],
        "image_version": fields["IMAGE_VERSION"],
        "base_digest": hashes[0],
        "storage_driver": "overlayfs",
        "immutable_base": True,
    }


def verify_immutable_root_mount(mountinfo: str) -> None:
    candidates = []
    for line in mountinfo.splitlines():
        fields = line.split()
        if len(fields) < 10 or fields[4] != "/" or "-" not in fields:
            continue
        separator = fields.index("-")
        if separator + 1 >= len(fields):
            continue
        candidates.append((fields[5].split(","), fields[separator + 1]))
    if len(candidates) != 1 or "ro" not in candidates[0][0] or candidates[0][1] != "erofs":
        raise VforgeError("Vforge requires the active Veyra EROFS root to be mounted read-only")


def ensure_vpkg_state(root: Path) -> None:
    database = root / "usr/lib/sysimage/rpm"
    if database.is_symlink() or not database.is_dir() or database.resolve(strict=True) != database:
        raise VforgeError("the Veyra root must contain a private RPM database at /usr/lib/sysimage/rpm")
    state_directories = (
        root / "var/lib/veyra/vpkg/container/history",
        root / "var/lib/veyra/vpkg/container/persist",
        root / "var/lib/veyra/vpkg/container/state",
        root / "var/lib/veyra/vpkg/container/log",
        root / "var/cache/veyra/vpkg/container",
    )
    for directory in state_directories:
        current = root
        for component in directory.relative_to(root).parts:
            current = current / component
            if current.is_symlink():
                raise VforgeError(f"Vpkg state path may not traverse symlinks: {directory}")
        directory.mkdir(mode=0o755, parents=True, exist_ok=True)
        if directory.is_symlink() or directory.resolve(strict=True) != directory:
            raise VforgeError(f"Vpkg state path is not private to the Vforge root: {directory}")


def run_environment(path: Path, command: Sequence[str]) -> int:
    metadata = environment_metadata(path)
    verify_project_mount_approvals(metadata)
    verify_immutable_root_mount(Path("/proc/self/mountinfo").read_text(encoding="utf-8"))
    runtime_root = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    if not runtime_root.is_absolute():
        raise VforgeError("XDG_RUNTIME_DIR must be an absolute path")
    verify_private_directory(runtime_root, "user runtime directory")
    runtime_parent = runtime_root / "vforge"
    ensure_private_directory(runtime_parent)
    with tempfile.TemporaryDirectory(prefix=f"{metadata['name']}-", dir=runtime_parent) as temporary:
        root = Path(temporary)
        lower, merged = root / "lower", root / "merged"
        lower.mkdir()
        merged.mkdir()
        mountpoints: list[str] = []

        def mount_at(target: Path, arguments: list[str]) -> None:
            run(arguments)
            mountpoints.append(str(target))

        operation_error: BaseException | None = None
        try:
            run(["mount", "--make-rprivate", "/"])
            mount_at(lower, ["mount", "--bind", "/", str(lower)])
            run(["mount", "-o", "remount,bind,ro", str(lower)])
            options = f"lowerdir={lower},upperdir={metadata['upper']},workdir={metadata['work']}"
            mount_at(merged, ["mount", "-t", "overlay", "overlay", "-o", options, str(merged)])
            if metadata.get("project"):
                workspace = merged / "workspace"
                workspace.mkdir(exist_ok=True)
                mount_in_namespace(metadata["project"], str(workspace), mountpoints=mountpoints)
                state_view = workspace / ".vforge"
                state_view.mkdir(exist_ok=True)
                mount_at(state_view, ["mount", "-t", "tmpfs", "-o", "mode=700,nosuid,nodev", "tmpfs", str(state_view)])
            for item in metadata.get("mounts", []):
                destination = merged / item["target"].lstrip("/")
                current = merged
                for component in PurePosixPath(item["target"]).parts[1:]:
                    current = current / component
                    if current.is_symlink():
                        raise VforgeError(f"mount target traverses a symlink in the Veyra lower: {item['target']}")
                destination.mkdir(parents=True, exist_ok=True)
                mount_in_namespace(
                    item["source"], str(destination),
                    readonly=item["access"] == "read-only", mountpoints=mountpoints,
                )
            for name in ("proc", "sys", "dev", "tmp", "run", "home"):
                (merged / name).mkdir(exist_ok=True)
            mount_at(merged / "proc", ["mount", "-t", "proc", "proc", str(merged / "proc")])
            mount_at(merged / "sys", ["mount", "-t", "tmpfs", "-o", "mode=755,nosuid,nodev", "tmpfs", str(merged / "sys")])
            mount_at(merged / "dev", ["mount", "-t", "tmpfs", "-o", "mode=755,nosuid", "tmpfs", str(merged / "dev")])
            (merged / "dev" / "pts").mkdir()
            (merged / "dev" / "shm").mkdir()
            for device in ("null", "zero", "random", "urandom", "tty"):
                (merged / "dev" / device).touch()
                if Path("/dev", device).exists():
                    mount_in_namespace(f"/dev/{device}", str(merged / "dev" / device), mountpoints=mountpoints)
            mount_at(merged / "dev/pts", ["mount", "-t", "devpts", "-o", "newinstance,nosuid,noexec,mode=0620,gid=0,ptmxmode=0666", "devpts", str(merged / "dev" / "pts")])
            (merged / "dev" / "ptmx").symlink_to("pts/ptmx")
            mount_at(merged / "dev/shm", ["mount", "-t", "tmpfs", "-o", "mode=1777,nosuid,nodev", "tmpfs", str(merged / "dev" / "shm")])
            mount_at(merged / "tmp", ["mount", "-t", "tmpfs", "-o", "mode=1777,nosuid,nodev", "tmpfs", str(merged / "tmp")])
            mount_at(merged / "run", ["mount", "-t", "tmpfs", "-o", "mode=755,nosuid,nodev", "tmpfs", str(merged / "run")])
            mount_at(merged / "home", ["mount", "-t", "tmpfs", "-o", "mode=755,nosuid,nodev", "tmpfs", str(merged / "home")])
            marker = veyra_root_marker(metadata, merged)
            marker_directory = merged / "run/veyra-vforge"
            marker_directory.mkdir(mode=0o755)
            marker_file = marker_directory / "root.json"
            marker_file.write_text(json.dumps(marker, sort_keys=True) + "\n", encoding="utf-8")
            marker_file.chmod(0o444)
            mount_at(marker_file, ["mount", "--bind", str(marker_file), str(marker_file)])
            run(["mount", "-o", "remount,bind,ro", str(marker_file)])
            child = os.fork()
            if child == 0:
                try:
                    os.chroot(merged)
                    ensure_vpkg_state(Path("/"))
                    os.chdir("/workspace" if metadata.get("project") else "/")
                    safe_environment = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"}
                    for key, value in os.environ.items():
                        if key == "TERM" or key == "LANG" or key.startswith("LC_"):
                            safe_environment[key] = value
                    safe_environment["HOME"] = "/workspace" if metadata.get("project") else "/tmp"
                    os.execvpe(command[0], list(command), safe_environment)
                except (OSError, VforgeError) as error:
                    print(f"vforge: cannot start command in environment: {error}", file=sys.stderr)
                    os._exit(127)
            _, status = os.waitpid(child, 0)
            return os.waitstatus_to_exitcode(status)
        except BaseException as error:
            operation_error = error
            raise
        finally:
            failures = unmount_all(mountpoints)
            if failures and operation_error is None:
                raise VforgeError("cannot unmount Vforge runtime mounts: " + ", ".join(failures))
    return 0


def list_environments() -> int:
    root = store_root() / "environments"
    if not root.is_dir():
        return 0
    for path in sorted(root.iterdir()):
        if (path / "environment.json").is_file():
            metadata = environment_metadata(path)
            print(f"{metadata['name']}\tOverlayFS\t{path}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="vforge", description="Native Veyra environments using OverlayFS and Linux namespaces")
    subparsers = parser.add_subparsers(dest="action", required=True)
    create_parser = subparsers.add_parser("create", help="create a persistent OverlayFS environment")
    create_parser.add_argument("name")
    create_parser.add_argument("--storage-root", type=Path, help="select the persistent root for named environments")
    for action in ("enter", "exec", "delete"):
        sub = subparsers.add_parser(action)
        sub.add_argument("name", nargs="?" if action == "enter" else None)
        if action == "exec":
            sub.add_argument("command", nargs=argparse.REMAINDER)
    subparsers.add_parser("list", help="list named environments")
    subparsers.add_parser("up", help="create or open the current project's environment")
    config = subparsers.add_parser("config", help="configure Vforge")
    config_sub = config.add_subparsers(dest="config_action", required=True)
    storage = config_sub.add_parser("storage-root", help="select persistent storage for named environments")
    storage.add_argument("path", type=Path)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        if args.action == "create":
            validate_name(args.name)
            # An explicit storage root selects a concrete environment directory.
            if args.storage_root:
                selected = args.storage_root.expanduser()
                if not selected.is_absolute():
                    raise VforgeError("Vforge storage root must be an absolute path")
                selected = selected.resolve()
                ensure_private_directory(selected)
                write_private_json(config_directory() / "config.json", {"storage_root": str(selected)}, "Vforge configuration")
            create(args.name)
            return 0
        if args.action == "up":
            project_up(Path.cwd())
            return 0
        if args.action == "list":
            return list_environments()
        if args.action == "config":
            selected = args.path.expanduser()
            if not selected.is_absolute():
                raise VforgeError("Vforge storage root must be an absolute path")
            selected = selected.resolve()
            ensure_private_directory(selected)
            write_private_json(config_directory() / "config.json", {"storage_root": str(selected)}, "Vforge configuration")
            print(selected)
            return 0
        if args.action == "enter" and args.name is None:
            path = project_up(Path.cwd())
            return namespace_command(path, [])
        if args.name is None:
            raise VforgeError("environment name is required")
        path = environment_path(args.name)
        if args.action in {"enter", "exec"}:
            command = args.command[1:] if args.action == "exec" and args.command[:1] == ["--"] else args.command if args.action == "exec" else []
            return namespace_command(path, command)
        if args.action == "delete":
            if path.exists():
                environment_metadata(path)
                shutil.rmtree(path)
                print(f"Deleted environment '{args.name}'")
            return 0
    except (OSError, VforgeError) as error:
        print(f"vforge: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "_run":
        try:
            sys.exit(run_environment(Path(sys.argv[2]), sys.argv[3:]))
        except (OSError, VforgeError) as error:
            print(f"vforge: {error}", file=sys.stderr)
            sys.exit(1)
    sys.exit(main())
