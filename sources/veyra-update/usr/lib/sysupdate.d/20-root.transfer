[Transfer]
ProtectVersion=%A
Verify=yes

[Source]
Type=url-file
Path=https://github.com/angyedz/Veyra-next/releases/latest/download/
MatchPattern=veyra-next_@v_@u.root.raw.zst

[Target]
Type=partition
Path=auto
MatchPattern=veyra-next_@v
MatchPartitionType=root
PartitionUUID=@u
PartitionFlags=0
ReadOnly=1
