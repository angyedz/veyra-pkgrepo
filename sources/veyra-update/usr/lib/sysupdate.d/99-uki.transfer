[Transfer]
ProtectVersion=%A
Verify=yes

[Source]
Type=url-file
Path=https://github.com/angyedz/Veyra-next/releases/latest/download/
MatchPattern=veyra-next_@v.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=veyra-next_@v+@l-@d.efi \
             veyra-next_@v+@l.efi \
             veyra-next_@v.efi
Mode=0444
TriesLeft=3
TriesDone=0
InstancesMax=2
