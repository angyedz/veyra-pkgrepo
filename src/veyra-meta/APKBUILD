pkgname=veyra-meta
pkgver=0.2.0
pkgrel=0
pkgdesc="Veyra desktop essentials meta package"
url="https://github.com/angyedz/Veyra-Linux"
arch="noarch"
license="MIT"
depends="vpkg veyra-themes veyra-update veyra-session veyra-welcome veyra-settings veyra-appcenter telegram-desktop flatpak flatpak-polkit xdg-document-portal"
options="!check"
source=""
builddir="$srcdir"
package() {
  install -d "$pkgdir/usr/share/doc/veyra-meta"
  install -Dm644 "$startdir/flathub.flatpakrepo" \
    "$pkgdir/usr/share/flatpak/remotes.d/flathub.flatpakrepo"
  printf '%s\n' 'Veyra Linux desktop essentials' > "$pkgdir/usr/share/doc/veyra-meta/README"
}
