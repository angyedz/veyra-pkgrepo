#!/bin/sh
set -eu
printf 'Native APK: '; command -v apk || :
printf 'Veyra package manager: '; command -v vpkg || :
printf 'glibc compatibility: '; command -v glenv || echo 'not initialized'
printf 'Nix: '; command -v nix || echo 'not installed'
printf 'Wine: '; command -v wine || echo 'not installed'
echo 'vpkg manages packages only inside the isolated Veyra user environment; it does not install system packages.'
echo 'Automatic Alpine APK -> Veyra APK -> Nix fallback is planned; Nix packages currently require --from nix.'
