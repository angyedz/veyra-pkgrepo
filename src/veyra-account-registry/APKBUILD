pkgname=veyra-account-registry
pkgver=0.1.0
pkgrel=0
pkgdesc="Root-owned persistent account and mapped UID/GID registry for Veyra"
url="https://github.com/angyedz/Veyra-Linux"
arch="x86_64"
license="MIT"
makedepends="build-base"
options="!check"
source=""
builddir="$srcdir"

build() {
    mkdir -p "$builddir"
    ${CC:-gcc} ${CPPFLAGS:-} ${CFLAGS:-} -std=c11 -D_FORTIFY_SOURCE=2 \
        -fPIE -pie -Wall -Wextra -Werror \
        -Wl,-z,relro,-z,now -o "$builddir/veyra-account-registry" \
        "$startdir/veyra-account-registry.c"
}

package() {
    install -Dm755 "$builddir/veyra-account-registry" \
        "$pkgdir/usr/sbin/veyra-account-registry"
    install -Dm644 "$startdir/README.md" \
        "$pkgdir/usr/share/doc/veyra-account-registry/README.md"
}
