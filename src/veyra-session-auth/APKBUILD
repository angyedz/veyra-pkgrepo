pkgname=veyra-session-auth
pkgver=0.1.0
pkgrel=0
pkgdesc="PAM account gate and one-use login grants for Veyra sessions"
url="https://github.com/angyedz/Veyra-Linux"
arch="x86_64"
license="MIT"
depends="linux-pam veyra-account-registry"
makedepends="build-base linux-pam-dev"
options="!check"
source=""
builddir="$srcdir"

build() {
    ${CC:-gcc} ${CPPFLAGS:-} ${CFLAGS:-} -std=c11 -D_FORTIFY_SOURCE=2 \
        -fPIC -Wall -Wextra -Werror -c \
        "$startdir/session-grant.c" -o "$builddir/session-grant.o"
    ${CC:-gcc} ${CPPFLAGS:-} ${CFLAGS:-} -std=c11 -D_FORTIFY_SOURCE=2 \
        -fPIC -shared -Wall -Wextra -Werror \
        -Wl,-z,relro,-z,now -o "$builddir/pam_veyra_session.so" \
        "$startdir/pam_veyra_session.c" "$builddir/session-grant.o" -lpam
    ${CC:-gcc} ${CPPFLAGS:-} ${CFLAGS:-} -std=c11 -D_FORTIFY_SOURCE=2 \
        -fPIE -pie -Wall -Wextra -Werror \
        -Wl,-z,relro,-z,now -o "$builddir/veyra-session-grant" \
        "$startdir/veyra-session-grant.c" "$startdir/session-grant.c"
}

package() {
    install -Dm755 "$builddir/pam_veyra_session.so" \
        "$pkgdir/usr/lib/security/pam_veyra_session.so"
    install -Dm755 "$builddir/veyra-session-grant" \
        "$pkgdir/usr/sbin/veyra-session-grant"
    install -Dm644 "$startdir/pam.d/veyra-login" \
        "$pkgdir/etc/pam.d/veyra-login"
    install -Dm644 "$startdir/README.md" \
        "$pkgdir/usr/share/doc/veyra-session-auth/README.md"
}
