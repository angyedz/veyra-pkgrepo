#!/usr/bin/env python3
"""Veyra AppCenter — Qt Quick frontend, APK + user-scoped Nix support."""
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

from PyQt6.QtCore import QObject, QThread, QUrl, pyqtSignal, pyqtProperty, pyqtSlot
from PyQt6.QtGui import QGuiApplication
from PyQt6.QtQml import QQmlApplicationEngine

ASSET_DIR = Path("/usr/share/veyra/appcenter")
if not (ASSET_DIR / "main.qml").is_file():
    ASSET_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(ASSET_DIR))
from backend import (parse_apk_search, parse_apk_installed, parse_nix_search,
                     parse_nix_profile, parse_flatpak_list, nix_cli, validate_name,
                     validate_flatpak_id, featured_packages,
                     featured_flatpak_packages, FLATHUB_URL)


class CommandThread(QThread):
    finished_command = pyqtSignal(int, str)

    def __init__(self, argv, timeout=180):
        super().__init__()
        self.argv = argv
        self.timeout = timeout

    def run(self):
        try:
            result = subprocess.run(self.argv, capture_output=True, text=True,
                                    errors="replace", timeout=self.timeout,
                                    check=False)
            self.finished_command.emit(result.returncode,
                                       (result.stdout + "\n" + result.stderr).strip())
        except (OSError, subprocess.TimeoutExpired) as error:
            self.finished_command.emit(1, str(error))


class PackageController(QObject):
    changed = pyqtSignal()
    busyChanged = pyqtSignal()
    statusChanged = pyqtSignal()

    def __init__(self):
        super().__init__()
        self._results = []
        self._busy = False
        self._status = "Search for an application or browse installed packages."
        self._worker = None

    @pyqtProperty("QVariantList", notify=changed)
    def results(self):
        return self._results

    @pyqtProperty(bool, notify=busyChanged)
    def busy(self):
        return self._busy

    @pyqtProperty(str, notify=statusChanged)
    def status(self):
        return self._status

    @pyqtProperty(bool, constant=True)
    def nixAvailable(self):
        return shutil.which("nix") is not None

    @pyqtProperty(bool, constant=True)
    def flatpakAvailable(self):
        return shutil.which("flatpak") is not None

    def set_status(self, message):
        self._status = message
        self.statusChanged.emit()

    def start(self, argv, parser, timeout=180, after=None):
        if self._busy:
            self.set_status("Another operation is still running.")
            return
        if not shutil.which(argv[0]):
            self.set_status("Missing command: " + argv[0])
            return
        self._busy = True
        self.busyChanged.emit()
        self.set_status("Working…")
        self._worker = CommandThread(argv, timeout)
        def handle(exit_code, output):
            self._busy = False
            self.busyChanged.emit()
            if exit_code != 0:
                self.set_status("Failed: " + (output[-600:] or "command exited with an error"))
                return
            try:
                if parser is not None:
                    self._results = parser(output)
                    self.changed.emit()
                    self.set_status(str(len(self._results)) + " packages")
                else:
                    self.set_status("Operation completed.")
                if after:
                    after()
            except (ValueError, json.JSONDecodeError) as error:
                self.set_status("Invalid package data: " + str(error))
        self._worker.finished_command.connect(handle)
        self._worker.start()

    @pyqtSlot(str, str)
    def featured(self, category, source):
        if self._busy:
            return
        try:
            if source == "flatpak":
                self._results = featured_flatpak_packages(category)
            else:
                self._results = featured_packages(category)
        except ValueError as error:
            self.set_status(str(error))
            return
        self.changed.emit()
        if source == "flatpak":
            self.set_status("Popular per-user applications from Flathub")
        else:
            self.set_status("Popular applications from the Alpine repositories")

    @pyqtSlot(str, str)
    def search(self, query, source):
        query = query.strip()
        if not query or len(query) > 120 or query.startswith("-"):
            self.set_status("Enter a search of 1–120 characters.")
            return
        if source == "apk":
            self.start(["apk", "search", "-v", "--", query], parse_apk_search)
        elif source == "flatpak" and self.flatpakAvailable:
            remote = ["flatpak", "remote-add", "--user", "--if-not-exists",
                      "flathub", FLATHUB_URL]
            search = ["flatpak", "search", "--user",
                      "--columns=application,name,description", "--", query]
            self.start(remote, None,
                       after=lambda: self.start(search, parse_flatpak_list))
        elif source == "nix" and self.nixAvailable:
            # Nix searches by regular expression; escape user input literally.
            self.start(nix_cli("search", "nixpkgs", re.escape(query), "--json"),
                       parse_nix_search, timeout=240)

    @pyqtSlot(str)
    def installed(self, source):
        if source == "apk":
            self.start(["apk", "info"], parse_apk_installed)
        elif source == "flatpak" and self.flatpakAvailable:
            self.start(["flatpak", "list", "--user", "--app",
                        "--columns=application,name,version"],
                       lambda output: parse_flatpak_list(output, installed=True))
        elif source == "nix" and self.nixAvailable:
            self.start(nix_cli("profile", "list", "--json"), parse_nix_profile)

    @pyqtSlot(str, str, str, str)
    def change(self, name, source, action, remove_key):
        if action not in ("install", "remove"):
            self.set_status("Unknown action.")
            return
        try:
            if source == "flatpak":
                validate_flatpak_id(name)
            else:
                validate_name(name)
        except ValueError as error:
            self.set_status(str(error))
            return
        if source == "apk":
            argv = ["pkexec", "apk", "add" if action == "install" else "del",
                    "--", name]
        elif source == "flatpak" and self.flatpakAvailable:
            if action == "install":
                remote = ["flatpak", "remote-add", "--user", "--if-not-exists",
                          "flathub", FLATHUB_URL]
                install = ["flatpak", "install", "--user", "--assumeyes",
                           "flathub", name]
                self.start(remote, None, after=lambda: self.start(install, None))
                return
            argv = ["flatpak", "uninstall", "--user", "--assumeyes", name]
        elif source == "nix" and self.nixAvailable:
            if action == "install":
                argv = nix_cli("profile", "install", "nixpkgs#" + name)
            else:
                if not remove_key.isdecimal():
                    self.set_status("Nix profile index unavailable; refusing removal.")
                    return
                argv = nix_cli("profile", "remove", remove_key)
        else:
            self.set_status("Unsupported package source.")
            return
        self.start(argv, None, timeout=900)

    @pyqtSlot(str)
    def refresh(self, source):
        if source == "apk":
            self.start(["pkexec", "apk", "update"], None)
        elif source == "flatpak" and self.flatpakAvailable:
            remote = ["flatpak", "remote-add", "--user", "--if-not-exists",
                      "flathub", FLATHUB_URL]
            refresh = ["flatpak", "update", "--user", "--appstream", "flathub"]
            self.start(remote, None, after=lambda: self.start(refresh, None))
        elif source == "nix":
            self.set_status("Nix packages are queried from nixpkgs on each search.")


def main():
    app = QGuiApplication(sys.argv)
    app.setApplicationName("Veyra AppCenter")
    engine = QQmlApplicationEngine()
    backend = PackageController()
    engine.rootContext().setContextProperty("backend", backend)
    engine.load(QUrl.fromLocalFile(str(ASSET_DIR / "main.qml")))
    if not engine.rootObjects():
        return 1
    return app.exec()


if __name__ == "__main__":
    raise SystemExit(main())
