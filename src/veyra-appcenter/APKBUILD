pkgname=veyra-appcenter
pkgver=0.2.0
pkgrel=0
pkgdesc="Qt6 application manager for Veyra Linux"
url="https://github.com/angyedz/veyra-pkgrepo"
arch="noarch"
license="MIT"
depends="python3 py3-pyqt6 polkit apk-tools"
options="!check"
source=""
builddir="$srcdir"
package() {
    install -Dm755 "$startdir/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "$startdir/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
}
