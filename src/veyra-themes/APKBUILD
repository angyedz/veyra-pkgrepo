pkgname=veyra-themes
pkgver=0.1.0
pkgrel=0
pkgdesc="Veyra Glacier branding, logos and fetch presets"
url="https://github.com/angyedz/Veyra-Linux"
arch="noarch"
license="MIT"
options="!check"
source=""
builddir="$srcdir"
package() {
  local root="$startdir/../.."
  install -Dm644 "$root/branding/veyra-logo.svg" "$pkgdir/usr/share/pixmaps/veyra-logo.svg"
  install -Dm644 "$root/branding/fastfetch/logo.txt" "$pkgdir/usr/share/veyra/fastfetch/logo.txt"
  install -Dm644 "$root/branding/fastfetch/config.jsonc" "$pkgdir/etc/fastfetch/config.jsonc"
}
