package() {
    install -Dm755 "$startdir/veyra-user-root-provisioner" \
        "$pkgdir/usr/sbin/veyra-user-root-provisioner"
    install -Dm644 "$startdir/README.md" \
        "$pkgdir/usr/share/doc/veyra-user-root-provisioner/README.md"
}
