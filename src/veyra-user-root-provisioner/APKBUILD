pkgname=veyra-user-root-provisioner
pkgver=0.1.0
pkgrel=0
pkgdesc="System-side persistent per-account Veyra user-root provisioner"
url="https://github.com/angyedz/Veyra-Linux"
arch="noarch"
license="MIT"
depends="veyra-account-registry coreutils util-linux-misc"
