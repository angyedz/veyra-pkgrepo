#!/bin/sh
set -eu
command -v zenity >/dev/null || { echo 'Veyra Settings requires zenity' >&2; exit 1; }
choice=$(zenity --list --title='Veyra Settings' --column='Tool' session hardware compatibility update --height=320) || exit 0
case "$choice" in
session) data=$(veyra-session status);;
hardware) data=$(veyra-hardware);;
compatibility) data=$(veyra-compat);;
update) data='Run sudo veyra-update in Konsole to upgrade installed APK packages.';;
*) exit 0;;
esac
printf '%s\n' "$data" | zenity --text-info --title="Veyra Settings — $choice" --width=700 --height=480
